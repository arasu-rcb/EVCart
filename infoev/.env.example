# Vite Client-Side Environment Variables (accessible via import.meta.env.VITE_*)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Frontend Email Service Configuration (EmailJS - No backend required)
# 1. Sign up free at https://www.emailjs.com (200 free emails/month)
# 2. Add an Email Service (e.g. Gmail) -> get Service ID
# 3. Create an Email Template with variables {{user_name}}, {{user_email}}, {{booking_id}}, {{vehicle_name}}, {{booking_date}}, {{booking_time}} -> get Template ID
# 4. Account > API Keys -> get Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Legacy alias fallback support
VITE_EMAIL_SERVICE_PUBLIC_KEY=
VITE_EMAIL_TEMPLATE_ID=
